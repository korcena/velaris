# Velaris environment — copy to .env.local and adjust as needed.

# Path to the SQLite database file (relative to project root).
VELARIS_DB_PATH=./db/velaris.db

# Web process port.
VELARIS_PORT=3000

# OpenCode server (execution engine). Used by the engine in Phase 2+.
OPENCODE_PORT=4096
OPENCODE_BASE_URL=http://127.0.0.1:4096

# Ollama HTTP endpoint (direct-Ollama houses, Phase 5).
OLLAMA_BASE_URL=http://localhost:11434
